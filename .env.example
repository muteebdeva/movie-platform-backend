# Copy to .env (local dev). NEVER commit real values.
# Production values live in each Vercel project's environment settings.

# Pooled Postgres connection string (Neon). Server-only secret.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# One-time admin bootstrap secret (server-only). Remove after first use.
BOOTSTRAP_SECRET=generate-with-openssl-rand-hex-32

# Public URL of the movie site, used for email links. Public.
APP_URL=https://muteeb-movie.vercel.app

# Comma-separated origins allowed for direct browser calls (the two frontends). Public.
ALLOWED_ORIGINS=https://muteeb-movie.vercel.app,https://muteeb-movie-admin.vercel.app

# Optional: Resend for verification + password-reset emails. Server-only secrets.
# If unset, accounts activate immediately and reset-by-email reports "not configured".
RESEND_API_KEY=
EMAIL_FROM=Movie Platform <no-reply@example.com>

# Optional: require verified email before sign-in. Defaults to true when
# RESEND_API_KEY is set, false otherwise. Set explicitly to override.
REQUIRE_EMAIL_VERIFICATION=
